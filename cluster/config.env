# cluster/config.env — single source of truth for MemorySplit FarmShare scripts.
# Adapted from ShrinkMuon/cluster/config.env (recon facts of 2026-07-12/13:
# gpu partition = 6x oat nodes, 4x L40S 48GB each; QOS gpu: MaxJobsPU=4,
# MaxSubmitPU=32, MaxTRESPU gres/gpu=4; MaxWall 2-00:00:00; python module
# 3.13.8 has ensurepip; login+compute nodes have pypi/HF egress).

if [ -n "${_MEMORYSPLIT_CLUSTER_CONFIG_LOADED:-}" ]; then
    return 0 2>/dev/null || exit 0
fi
_MEMORYSPLIT_CLUSTER_CONFIG_LOADED=1

# Defaults to the invoking user, so the same package runs in any account:
# on FarmShare $USER is the SUNetID; override with `export SUNET_ID=...`
# when driving remotely from a laptop.
SUNET_ID="${SUNET_ID:-$USER}"

LOGIN_HOST="${LOGIN_HOST:-rice-04.farmshare.stanford.edu}"
DTN_HOST="${DTN_HOST:-dtn.farmshare.stanford.edu}"

FS_SCRATCH='/scratch/users/${SUNET_ID}'
FS_REPO_DIR='${FS_SCRATCH}/memorysplit'
FS_VENV='${FS_SCRATCH}/venvs/memorysplit'
FS_DATA='${FS_SCRATCH}/memorysplit_data'
FS_LOGS='${FS_SCRATCH}/logs'

PYTHON_MODULE="${PYTHON_MODULE:-python/3.13.8}"

GPU_PARTITION="${GPU_PARTITION:-gpu}"
GPU_QOS="${GPU_QOS:-gpu}"
GPU_GRES="${GPU_GRES:-gpu:1}"
CPU_PARTITION="${CPU_PARTITION:-normal}"

TIME_SMOKE="${TIME_SMOKE:-00:30:00}"
TIME_DATA="${TIME_DATA:-08:00:00}"
TIME_TRAIN="${TIME_TRAIN:-47:00:00}"   # just under the 2-day MaxWall; runs checkpoint+requeue

ARRAY_THROTTLE="${ARRAY_THROTTLE:-4}"

require_sunet() {
    if [ -z "${SUNET_ID:-}" ]; then
        echo "ERROR: SUNET_ID is not set." >&2
        exit 1
    fi
}

# guard_claim: authorise GPU-hours and scratch against the preregistered
# ceiling before submitting. Every path that reaches `sbatch` for a training
# run calls this first, and `tests/test_guard.py` fails if one does not.
#
# The ceiling lives in docs/PREREGISTRATION.md §10a and nowhere else. A
# refusal exits 3, and every caller runs under `set -e`, so the sbatch below
# it never happens. That is the whole point: this account was cancelled once
# at 261 GB against a 150 GB budget that only a runbook knew about.
#
#   guard_claim_cfg <campaign> <run-config.yaml>
#
# Takes the run id and the token budget from the same YAML the trainer reads,
# so the number that was authorised and the number that gets spent cannot
# differ. Passing them separately is how a guarded pipeline quietly stops
# guarding the thing it submits.
_guard_ledger() {
    printf '%s' "${MS_GUARD_LEDGER:-$(expand_path "$FS_SCRATCH")/crowding/logs/resource_ledger.jsonl}"
}

guard_claim_cfg() {
    local campaign="$1" cfg="$2"
    PYTHONPATH="${MS_CODE_DIR:-${REPO:-.}}" "${PY:-python3}" -m ops.crowding.guard \
        claim --campaign "$campaign" --config "$cfg" --ledger "$(_guard_ledger)"
}

expand_path() {
    local val="$1"
    local prev=""
    while [ "$val" != "$prev" ]; do
        prev="$val"
        val="${val//\$\{SUNET_ID\}/$SUNET_ID}"
        val="${val//\$\{FS_SCRATCH\}/$FS_SCRATCH}"
    done
    printf '%s' "$val"
}

# cm_socket: pick a live ControlMaster socket. connect.sh writes
# ~/.ssh/cm-<user>@<host>:22; manual sessions on this machine have used
# ~/.ssh/cm-farmshare. Prefer whichever exists.
cm_socket() {
    if [ -S "$HOME/.ssh/cm-farmshare" ]; then
        printf '%s' "$HOME/.ssh/cm-farmshare"
    else
        printf '%s' "$HOME/.ssh/cm-%r@%h:%p"
    fi
}

init_modules() {
    if ! type module >/dev/null 2>&1; then
        if [ -r /etc/profile.d/z00_lmod.sh ]; then
            local restore_nounset=0
            case "$-" in *u*) restore_nounset=1; set +u ;; esac
            # shellcheck source=/dev/null
            source /etc/profile.d/z00_lmod.sh
            if [ "$restore_nounset" -eq 1 ]; then set -u; fi
        else
            echo "WARNING: Lmod init script not found; module unavailable." >&2
            return 1
        fi
    fi
}
