# MemorySplit Task 5A: static no-instance/private-foundation invariants.
# Exact SSM canonical JSON identity and closed outputs are checked by pytest.

let ec2_instances = Resources.*[ Type == 'AWS::EC2::Instance' ]
let auto_scaling_groups = Resources.*[
  Type == 'AWS::AutoScaling::AutoScalingGroup'
]
let ec2_fleets = Resources.*[ Type == 'AWS::EC2::EC2Fleet' ]
let spot_fleets = Resources.*[ Type == 'AWS::EC2::SpotFleet' ]
let capacity_reservations = Resources.*[
  Type == 'AWS::EC2::CapacityReservation'
]
let capacity_reservation_fleets = Resources.*[
  Type == 'AWS::EC2::CapacityReservationFleet'
]

let internet_gateways = Resources.*[ Type == 'AWS::EC2::InternetGateway' ]
let nat_gateways = Resources.*[ Type == 'AWS::EC2::NatGateway' ]
let elastic_ips = Resources.*[ Type == 'AWS::EC2::EIP' ]
let gateway_attachments = Resources.*[
  Type == 'AWS::EC2::VPCGatewayAttachment'
]
let public_routes = Resources.*[
  Type == 'AWS::EC2::Route'
  Properties.DestinationCidrBlock == '0.0.0.0/0'
]

let subnets = Resources.*[ Type == 'AWS::EC2::Subnet' ]

