let train_policy_statements = Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[*]
let train_s3_read_statements = %train_policy_statements[
  Action == 's3:GetObject' or
  some Action[*] == 's3:GetObject'
]
let train_s3_write_statements = %train_policy_statements[
  Action == 's3:PutObject' or
  some Action[*] == 's3:PutObject'
]
let train_s3_list_statements = %train_policy_statements[
  Action == 's3:ListBucket' or
  some Action[*] == 's3:ListBucket'
]
let evaluator_policy_statements = Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[*]
let evaluator_s3_read_statements = %evaluator_policy_statements[
  Action == 's3:GetObject' or
  some Action[*] == 's3:GetObject'
]
let evaluator_s3_write_statements = %evaluator_policy_statements[
  Action == 's3:PutObject' or
  some Action[*] == 's3:PutObject'
]
let evaluator_s3_list_statements = %evaluator_policy_statements[
  Action == 's3:ListBucket' or
  some Action[*] == 's3:ListBucket'
]
let controller_policy_statements = Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[*]
let controller_s3_read_statements = %controller_policy_statements[
  Action == 's3:GetObject' or
  some Action[*] == 's3:GetObject'
]
let controller_s3_write_statements = %controller_policy_statements[
  Action == 's3:PutObject' or
  some Action[*] == 's3:PutObject'
]
let controller_s3_list_statements = %controller_policy_statements[
  Action == 's3:ListBucket' or
  some Action[*] == 's3:ListBucket'
]

rule no_ec2_instances {
  %ec2_instances empty
}

rule no_auto_scaling_groups {
  %auto_scaling_groups empty
}

rule no_ec2_fleets {
  %ec2_fleets empty
}

rule no_spot_fleets {
  %spot_fleets empty
}

rule no_capacity_reservations {
  %capacity_reservations empty
}

rule no_capacity_reservation_fleets {
  %capacity_reservation_fleets empty
}

rule no_internet_gateways {
  %internet_gateways empty
}

rule no_nat_gateways {
  %nat_gateways empty
}

rule no_elastic_ips {
  %elastic_ips empty
}

rule no_public_gateway_attachments {
  %gateway_attachments empty
}

rule no_default_public_routes {
  %public_routes empty
}

rule all_subnets_disable_public_ip when %subnets !empty {
  %subnets.Properties.MapPublicIpOnLaunch == false
}

rule train_security_group_has_zero_ingress {
  Resources.TrainSecurityGroup.Type == 'AWS::EC2::SecurityGroup'
  Resources.TrainSecurityGroup.Properties.SecurityGroupIngress empty
}

rule endpoint_ingress_is_https_only {
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress[*].FromPort == 443
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress[*].ToPort == 443
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress[*].IpProtocol == 'tcp'
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress[*].CidrIp !exists
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress[*].CidrIpv6 !exists
}

rule launch_template_is_private_imdsv2_p5 {
  Resources.P5LaunchTemplate.Type == 'AWS::EC2::LaunchTemplate'
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.InstanceType == 'p5.48xlarge'
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.KeyName !exists
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpTokens == 'required'
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpEndpoint == 'enabled'
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpPutResponseHopLimit == 1
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.NetworkInterfaces[*].AssociatePublicIpAddress == false
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.NetworkInterfaces[*].SubnetId.Ref == 'PrivateSubnetA'
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.Encrypted == true
  Resources.P5LaunchTemplate.Properties.LaunchTemplateData.DisableApiTermination == false
}

rule retained_versioned_kms_bucket {
  Resources.ArtifactBucket.Type == 'AWS::S3::Bucket'
  Resources.ArtifactBucket.DeletionPolicy == 'Retain'
  Resources.ArtifactBucket.UpdateReplacePolicy == 'Retain'
  Resources.ArtifactBucket.Properties.VersioningConfiguration.Status == 'Enabled'
  Resources.ArtifactBucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm == 'aws:kms'
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true
}

rule retained_symmetric_data_key {
  Resources.DataKey.Type == 'AWS::KMS::Key'
  Resources.DataKey.DeletionPolicy == 'Retain'
  Resources.DataKey.UpdateReplacePolicy == 'Retain'
  Resources.DataKey.Properties.KeySpec == 'SYMMETRIC_DEFAULT'
  Resources.DataKey.Properties.KeyUsage == 'ENCRYPT_DECRYPT'
  Resources.DataKey.Properties.EnableKeyRotation == true
}

rule retained_p384_approval_key {
  Resources.ApprovalSigningKey.Type == 'AWS::KMS::Key'
  Resources.ApprovalSigningKey.DeletionPolicy == 'Retain'
  Resources.ApprovalSigningKey.UpdateReplacePolicy == 'Retain'
  Resources.ApprovalSigningKey.Properties.KeySpec == 'ECC_NIST_P384'
  Resources.ApprovalSigningKey.Properties.KeyUsage == 'SIGN_VERIFY'
}

rule immutable_kms_ecr {
  Resources.ContainerRepository.Type == 'AWS::ECR::Repository'
  Resources.ContainerRepository.DeletionPolicy == 'Retain'
  Resources.ContainerRepository.UpdateReplacePolicy == 'Retain'
  Resources.ContainerRepository.Properties.ImageTagMutability == 'IMMUTABLE'
  Resources.ContainerRepository.Properties.ImageScanningConfiguration.ScanOnPush == true
  Resources.ContainerRepository.Properties.EncryptionConfiguration.EncryptionType == 'KMS'
}

rule separate_operation_roles {
  Resources.TrainRole.Type == 'AWS::IAM::Role'
  Resources.EvaluatorRole.Type == 'AWS::IAM::Role'
  Resources.ControllerRole.Type == 'AWS::IAM::Role'
  Resources.ControllerOperationsPolicy.Type == 'AWS::IAM::Policy'
  Resources.SignerRole.Type == 'AWS::IAM::Role'
  Resources.TrainInstanceProfile.Type == 'AWS::IAM::InstanceProfile'
}

rule meaningful_role_policy_invariants {
  Resources.TrainRole.Properties.AssumeRolePolicyDocument.Statement[ Sid == 'Ec2AssumeRole' ].Principal.Service == 'ec2.amazonaws.com'
  Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListTrainPrefixes' ] !empty
  Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListTrainPrefixes' ].Condition exists
  Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListEvaluatorPrefixes' ] !empty
  Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListEvaluatorPrefixes' ].Condition exists

  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'RunApprovedLaunchTemplate' ] {
    Action == 'ec2:RunInstances'
    Condition.Bool[ keys == 'ec2:IsLaunchTemplateResource' ] == 'true'
  }
  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'TerminateBoundInstance' ] {
    Action == 'ec2:TerminateInstances'
    Condition.StringEquals[ keys == 'ec2:ResourceTag/MemorySplitManaged' ] == 'true'
  }
  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'SendToTaggedInstances' ] {
    Action == 'ssm:SendCommand'
    Condition.StringEquals[ keys == 'ssm:resourceTag/MemorySplitManaged' ] == 'true'
  }
  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'CreateEbsGrant' ] {
    Action == 'kms:CreateGrant'
    Condition.Bool[ keys == 'kms:GrantIsForAWSResource' ] == 'true'
  }
  Resources.SignerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'SignWithApprovalKey' ] {
    some Action[*] == 'kms:Sign'
  }
}

rule exact_s3_role_separation {
  Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListTrainPrefixes' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %train_list_prefixes
  Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadTrainingInputs' ] {
    some Action[*] == 's3:GetObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %train_read_resources
  }
  Resources.TrainRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadWriteTrainingArtifacts' ] {
    some Action[*] == 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %train_write_resources
  }
  %train_s3_list_statements.Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %train_list_prefixes
  %train_s3_read_statements.Resource[*][ keys == 'Fn::Sub' ] IN %train_readable_resources
  %train_s3_write_statements.Resource[*][ keys == 'Fn::Sub' ] IN %train_write_resources

  Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListEvaluatorPrefixes' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %evaluator_list_prefixes
  Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadEvaluationInputs' ] {
    Action[*] != 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %evaluator_read_resources
  }
  Resources.EvaluatorRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadWriteEvaluationEvidence' ] {
    some Action[*] == 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %evaluator_write_resources
  }
  %evaluator_s3_list_statements.Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %evaluator_list_prefixes
  %evaluator_s3_read_statements.Resource[*][ keys == 'Fn::Sub' ] IN %evaluator_readable_resources
  %evaluator_s3_write_statements.Resource[*][ keys == 'Fn::Sub' ] IN %evaluator_write_resources

  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'ListControllerPrefixes' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %controller_list_prefixes
  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'ReadLifecycleArtifacts' ] {
    Action[*] != 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %controller_read_resources
  }
  Resources.ControllerOperationsPolicy.Properties.PolicyDocument.Statement[ Sid == 'WriteControllerPublications' ] {
    Action == 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] IN %controller_write_resources
  }
  %controller_s3_list_statements.Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*][ keys == 'Fn::Sub' ] IN %controller_list_prefixes
  %controller_s3_read_statements.Resource[*][ keys == 'Fn::Sub' ] IN %controller_read_resources
  %controller_s3_write_statements.Resource[*][ keys == 'Fn::Sub' ] IN %controller_write_resources
  Resources.S3Endpoint.Properties.PolicyDocument.Statement[ Sid == 'MemorySplitVersionedObjects' ] {
    Resource[*][ keys == 'Fn::Sub' ] IN %endpoint_object_resources
  }
}
