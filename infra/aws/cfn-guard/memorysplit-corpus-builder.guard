rule launch_template_is_private_imdsv2_i4i {
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.InstanceType == 'i4i.16xlarge'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.ImageId.Ref == 'BuilderAmiId'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.KeyName !exists
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.InstanceInitiatedShutdownBehavior == 'terminate'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.DisableApiTermination == false
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.EbsOptimized == true
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.Monitoring.Enabled == true
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpTokens == 'required'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpEndpoint == 'enabled'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpProtocolIpv6 == 'disabled'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.HttpPutResponseHopLimit == 1
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.MetadataOptions.InstanceMetadataTags == 'disabled'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.NetworkInterfaces[*].AssociatePublicIpAddress == false
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.NetworkInterfaces[*].SubnetId.Ref == 'PrivateSubnet'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.DeleteOnTermination == true
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.Encrypted == true
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.VolumeSize == 200
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.VolumeType == 'gp3'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.KmsKeyId[ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.TagSpecifications[ ResourceType == 'instance' ].Tags[ Key == 'MemorySplitCorpusBuilder' ].Value == 'true'
  Resources.BuilderLaunchTemplate.Properties.LaunchTemplateData.TagSpecifications[ ResourceType == 'volume' ].Tags[ Key == 'MemorySplitCorpusBuilder' ].Value == 'true'
}

rule retained_encrypted_state {
  Resources.DataKey.DeletionPolicy == 'Retain'
  Resources.DataKey.UpdateReplacePolicy == 'Retain'
  Resources.DataKey.Properties.KeySpec == 'SYMMETRIC_DEFAULT'
  Resources.DataKey.Properties.KeyUsage == 'ENCRYPT_DECRYPT'
  Resources.DataKey.Properties.EnableKeyRotation == true

  Resources.ArtifactBucket.DeletionPolicy == 'Retain'
  Resources.ArtifactBucket.UpdateReplacePolicy == 'Retain'
  Resources.ArtifactBucket.Properties.BucketName == 'memorysplit-corpus-056956104102-us-east-1'
  Resources.ArtifactBucket.Properties.VersioningConfiguration.Status == 'Enabled'
  Resources.ArtifactBucket.Properties.ObjectLockEnabled == true
  Resources.ArtifactBucket.Properties.ObjectLockConfiguration.ObjectLockEnabled == 'Enabled'
  Resources.ArtifactBucket.Properties.ObjectLockConfiguration.Rule.DefaultRetention.Mode == 'GOVERNANCE'
  Resources.ArtifactBucket.Properties.ObjectLockConfiguration.Rule.DefaultRetention.Days == 365
  Resources.ArtifactBucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm == 'aws:kms'
  Resources.ArtifactBucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.KMSMasterKeyID[ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
  Resources.ArtifactBucket.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true

  Resources.BuilderLogGroup.DeletionPolicy == 'Retain'
  Resources.BuilderLogGroup.UpdateReplacePolicy == 'Retain'
  Resources.BuilderLogGroup.Properties.KmsKeyId[ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
}

rule exact_iam_policy_containers {
  let iam_resource_count = count(%iam_resources)
  let iam_role_count = count(%iam_roles)
  let iam_instance_profile_count = count(%iam_instance_profiles)
  let builder_inline_policy_count = count(%builder_inline_policies)
  let controller_inline_policy_count = count(%controller_inline_policies)
  let builder_managed_policy_count = count(Resources.BuilderRole.Properties.ManagedPolicyArns[*])
  let s3_bucket_policy_count = count(%s3_bucket_policy_resources)
  let nested_policy_container_count = count(%unexpected_nested_policy_containers)

  %iam_resource_count == 3
  %iam_role_count == 2
  %iam_instance_profile_count == 1
  %iam_policy_resources empty
  %iam_managed_policy_resources empty
  %s3_bucket_policy_count == 1
  %sns_topic_policy_resources empty
  %nested_policy_container_count == 2

  %builder_inline_policy_count == 1
  %controller_inline_policy_count == 1
  Resources.BuilderRole.Properties.Policies[*].PolicyName == 'BuilderCorpusData'
  Resources.ControllerRole.Properties.Policies[*].PolicyName == 'ControllerOperations'

  %builder_managed_policy_count == 1
  Resources.BuilderRole.Properties.ManagedPolicyArns[*][ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore'
  Resources.ControllerRole.Properties.ManagedPolicyArns !exists
  Resources.BuilderRole.Properties.PermissionsBoundary !exists
  Resources.ControllerRole.Properties.PermissionsBoundary !exists
  Resources.BuilderInstanceProfile.Properties.Roles[*].Ref == 'BuilderRole'
}

rule exact_builder_policy {
  let builder_statement_count = count(%builder_policy_statements)
  let builder_s3_statement_count = count(%builder_s3_statements)
  let builder_list_prefix_count = count(Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListCorpusNamespaces' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*])

  %builder_statement_count == 6
  %builder_s3_statement_count == 4
  %builder_list_prefix_count == 6
  exact_action_allowlist(%builder_policy_statements, %builder_allowed_actions)
  exact_s3_statement_shape(%builder_s3_statements, %builder_s3_sids)

  Resources.BuilderRole.Properties.AssumeRolePolicyDocument.Statement[ Sid == 'Ec2AssumeRole' ] {
    Action == 'sts:AssumeRole'
    Principal.Service == 'ec2.amazonaws.com'
  }
  Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ListCorpusNamespaces' ] {
    some Action[*] == 's3:ListBucket'
    some Action[*] == 's3:ListBucketVersions'
    Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*] IN %approved_list_prefixes
  }
  Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadBuilderInputs' ] {
    Action[*] IN ['s3:GetObject', 's3:GetObjectAttributes', 's3:GetObjectVersion']
    Resource[*][ keys == 'Fn::Sub' ] IN [
      '${ArtifactBucket.Arn}/v2/packages/*',
      '${ArtifactBucket.Arn}/v2/sources/*'
    ]
  }
  Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'ReadWriteBuildArtifacts' ] {
    some Action[*] == 's3:PutObject'
    Resource[*][ keys == 'Fn::Sub' ] == '${ArtifactBucket.Arn}/v2/builds/*'
  }
  Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'UseDataKey' ] {
    Action[*] IN ['kms:Decrypt', 'kms:DescribeKey', 'kms:Encrypt', 'kms:GenerateDataKey']
    Resource[ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
  }
  Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'WriteBuilderLogs' ] {
    Action[*] IN ['logs:CreateLogStream', 'logs:PutLogEvents']
    Resource[ keys == 'Fn::GetAtt' ] == ['BuilderLogGroup', 'Arn']
  }
}

rule exact_controller_policy {
  let controller_statement_count = count(%controller_policy_statements)
  %controller_statement_count == 12
  exact_action_allowlist(%controller_policy_statements, %controller_allowed_actions)

  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'RunApprovedLaunchTemplate' ] {
    Action == 'ec2:RunInstances'
    Resource == '*'
    Condition.ArnEquals[ keys == 'ec2:LaunchTemplate' ][ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:launch-template/${BuilderLaunchTemplate}'
    Condition.Bool[ keys == 'ec2:IsLaunchTemplateResource' ] == 'true'
    Condition.StringEquals[ keys == 'aws:RequestTag/MemorySplitCorpusBuilder' ] == 'true'
    Condition.StringEquals[ keys == 'ec2:InstanceType' ] == 'i4i.16xlarge'
    Condition.StringEquals[ keys == 'ec2:MetadataHttpTokens' ] == 'required'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'TagApprovedLaunchResources' ] {
    Action == 'ec2:CreateTags'
    Condition.StringEquals[ keys == 'aws:RequestTag/MemorySplitCorpusBuilder' ] == 'true'
    Condition.StringEquals[ keys == 'ec2:CreateAction' ] == 'RunInstances'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'SetBuilderShutdownBehavior' ] {
    Action == 'ec2:ModifyInstanceAttribute'
    Resource[ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*'
    Condition.StringEquals[ keys == 'ec2:ResourceTag/MemorySplitCorpusBuilder' ] == 'true'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'TerminateTaggedBuilder' ] {
    Action == 'ec2:TerminateInstances'
    Resource[ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*'
    Condition.StringEquals[ keys == 'ec2:ResourceTag/MemorySplitCorpusBuilder' ] == 'true'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'PassOnlyBuilderRoleToEc2' ] {
    Action == 'iam:PassRole'
    Resource[ keys == 'Fn::GetAtt' ] == ['BuilderRole', 'Arn']
    Condition.StringEquals[ keys == 'iam:PassedToService' ] == 'ec2.amazonaws.com'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'SendBuilderDocument' ] {
    Action == 'ssm:SendCommand'
    Resource[ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:document/${BuilderCommandDocument}'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'SendToTaggedBuilder' ] {
    Action == 'ssm:SendCommand'
    Resource[ keys == 'Fn::Sub' ] == 'arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*'
    Condition.StringEquals[ keys == 'ssm:resourceTag/MemorySplitCorpusBuilder' ] == 'true'
  }
  Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[ Sid == 'CreateEbsGrant' ] {
    Action == 'kms:CreateGrant'
    Resource[ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
    Condition.Bool[ keys == 'kms:GrantIsForAWSResource' ] == 'true'
  }
}

rule exact_s3_endpoint_policy {
  let endpoint_s3_statement_count = count(%endpoint_s3_statements)
  let endpoint_list_prefix_count = count(Resources.S3Endpoint.Properties.PolicyDocument.Statement[ Sid == 'CorpusBucketListing' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*])

  %endpoint_s3_statement_count == 4
  %endpoint_list_prefix_count == 6
  exact_s3_statement_shape(%endpoint_s3_statements, %endpoint_s3_sids)
  Resources.S3Endpoint.Properties.PolicyDocument.Statement[ Sid == 'CorpusBucketListing' ].Condition[ keys == 'ForAnyValue:StringLike' ][ keys == 's3:prefix' ][*] IN %approved_list_prefixes
}

rule bucket_policy_is_transport_and_kms_deny_only {
  let bucket_policy_statement_count = count(%bucket_policy_statements)
  %bucket_policy_statement_count == 3

  Resources.ArtifactBucketPolicy.Properties.PolicyDocument.Statement[ Sid == 'DenyInsecureTransport' ] {
    Effect == 'Deny'
    Principal == '*'
    Action == 's3:*'
    NotAction !exists
    NotResource !exists
    Condition.Bool[ keys == 'aws:SecureTransport' ] == 'false'
  }
  Resources.ArtifactBucketPolicy.Properties.PolicyDocument.Statement[ Sid == 'DenyUnexpectedEncryptionAlgorithm' ] {
    Effect == 'Deny'
    Principal == '*'
    Action == 's3:PutObject'
    Resource[ keys == 'Fn::Sub' ] == '${ArtifactBucket.Arn}/v2/builds/*'
    Condition.Null[ keys == 's3:x-amz-server-side-encryption' ] == 'false'
    Condition.StringNotEquals[ keys == 's3:x-amz-server-side-encryption' ] == 'aws:kms'
  }
  Resources.ArtifactBucketPolicy.Properties.PolicyDocument.Statement[ Sid == 'DenyUnexpectedKmsKey' ] {
    Effect == 'Deny'
    Principal == '*'
    Action == 's3:PutObject'
    Resource[ keys == 'Fn::Sub' ] == '${ArtifactBucket.Arn}/v2/builds/*'
    Condition.Null[ keys == 's3:x-amz-server-side-encryption-aws-kms-key-id' ] == 'false'
    Condition.StringNotEquals[ keys == 's3:x-amz-server-side-encryption-aws-kms-key-id' ][ keys == 'Fn::GetAtt' ] == ['DataKey', 'Arn']
  }
}

rule reject_unreviewed_policy_statements {
  policy_statement_basics(%builder_policy_statements)
  policy_statement_basics(%controller_policy_statements)
  policy_statement_basics(%builder_assume_role_statements)
  policy_statement_basics(%controller_assume_role_statements)
  policy_statement_basics(%endpoint_policy_statements)
  policy_statement_basics(%bucket_non_transport_statements)

  %controller_s3_statements empty
  %data_key_s3_statements empty
  %builder_assume_s3_statements empty
  %controller_assume_s3_statements empty
}

rule exact_ssm_document_and_budget {
  Resources.BuilderCommandDocument.Properties.Name == 'MemorySplit-CorpusBuilderV1'
  Resources.BuilderCommandDocument.Properties.DocumentType == 'Command'
  Resources.BuilderCommandDocument.Properties.DocumentFormat == 'JSON'
  Resources.BuilderCommandDocument.Properties.TargetType == '/AWS::EC2::Instance'
  Resources.BuilderCommandDocument.Properties.Content.schemaVersion == '2.2'

  Resources.MonthlyBudget.Properties.Budget.BudgetLimit.Amount == 200
  Resources.MonthlyBudget.Properties.Budget.BudgetLimit.Unit == 'USD'
  Resources.MonthlyBudget.Properties.Budget.BudgetType == 'COST'
  Resources.MonthlyBudget.Properties.Budget.TimeUnit == 'MONTHLY'
}
