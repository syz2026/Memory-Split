  Resources.SsmMessagesEndpoint.Properties.VpcEndpointType == 'Interface'
  Resources.SsmMessagesEndpoint.Properties.PrivateDnsEnabled == true
  Resources.SsmMessagesEndpoint.Properties.ServiceName[ keys == 'Fn::Sub' ] == 'com.amazonaws.${AWS::Region}.ssmmessages'
  Resources.SsmMessagesEndpoint.Properties.SubnetIds[*].Ref == 'PrivateSubnet'

  Resources.StsEndpoint.Properties.VpcEndpointType == 'Interface'
