# MemorySplit Task 5: static private, no-instance corpus-builder invariants.
# Closed outputs and secret-like byte patterns are checked by pytest.

let ec2_instances = Resources.*[ Type == 'AWS::EC2::Instance' ]
let auto_scaling_groups = Resources.*[
  Type == 'AWS::AutoScaling::AutoScalingGroup'
]
let ec2_fleets = Resources.*[ Type == 'AWS::EC2::EC2Fleet' ]
let spot_fleets = Resources.*[ Type == 'AWS::EC2::SpotFleet' ]
let capacity_reservations = Resources.*[
  Type == 'AWS::EC2::CapacityReservation'
]
let capacity_reservation_fleets = Resources.*[
  Type == 'AWS::EC2::CapacityReservationFleet'
]

let internet_gateways = Resources.*[ Type == 'AWS::EC2::InternetGateway' ]
let nat_gateways = Resources.*[ Type == 'AWS::EC2::NatGateway' ]
let elastic_ips = Resources.*[ Type == 'AWS::EC2::EIP' ]
let gateway_attachments = Resources.*[
  Type == 'AWS::EC2::VPCGatewayAttachment'
]
let public_routes = Resources.*[
  Type == 'AWS::EC2::Route'
  Properties.DestinationCidrBlock == '0.0.0.0/0'
]
let all_routes = Resources.*[ Type == 'AWS::EC2::Route' ]
let key_pairs = Resources.*[ Type == 'AWS::EC2::KeyPair' ]
let ecr_repositories = Resources.*[ Type == 'AWS::ECR::Repository' ]

let all_resources = Resources.*
let subnets = Resources.*[ Type == 'AWS::EC2::Subnet' ]
let vpc_endpoints = Resources.*[ Type == 'AWS::EC2::VPCEndpoint' ]
let iam_resources = Resources.*[ Type == /AWS::IAM::.*/ ]
let iam_roles = Resources.*[ Type == 'AWS::IAM::Role' ]
let iam_instance_profiles = Resources.*[
  Type == 'AWS::IAM::InstanceProfile'
]
let iam_policy_resources = Resources.*[ Type == 'AWS::IAM::Policy' ]
let iam_managed_policy_resources = Resources.*[
  Type == 'AWS::IAM::ManagedPolicy'
]
let s3_bucket_policy_resources = Resources.*[
  Type == 'AWS::S3::BucketPolicy'
]
let sns_topic_policy_resources = Resources.*[
  Type == 'AWS::SNS::TopicPolicy'
]
let nested_property_structs = Resources.*.Properties.*[
  this is_struct
]
let unexpected_nested_policy_containers = %nested_property_structs[
  PolicyDocument exists
]

let builder_inline_policies = Resources.BuilderRole.Properties.Policies[*]
let controller_inline_policies = Resources.ControllerRole.Properties.Policies[*]
let builder_policy_statements = Resources.BuilderRole.Properties.Policies[*].PolicyDocument.Statement[*]
let controller_policy_statements = Resources.ControllerRole.Properties.Policies[*].PolicyDocument.Statement[*]
let builder_assume_role_statements = Resources.BuilderRole.Properties.AssumeRolePolicyDocument.Statement[*]
let controller_assume_role_statements = Resources.ControllerRole.Properties.AssumeRolePolicyDocument.Statement[*]
let endpoint_policy_statements = Resources.S3Endpoint.Properties.PolicyDocument.Statement[*]
let bucket_policy_statements = Resources.ArtifactBucketPolicy.Properties.PolicyDocument.Statement[*]
let bucket_non_transport_statements = %bucket_policy_statements[
  Sid != 'DenyInsecureTransport'
]
let data_key_policy_statements = Resources.DataKey.Properties.KeyPolicy.Statement[*]

let builder_s3_statements = %builder_policy_statements[
  Action == /(?i)^s3:.*/ or
  some Action[*] == /(?i)^s3:.*/
]
let endpoint_s3_statements = %endpoint_policy_statements[
  Action == /(?i)^s3:.*/ or
  some Action[*] == /(?i)^s3:.*/
]
let controller_s3_statements = %controller_policy_statements[
  Action == /(?i)^s3:.*/ or
  some Action[*] == /(?i)^s3:.*/
]
let data_key_s3_statements = %data_key_policy_statements[
  Action == '*' or
  Action == /(?i)^s3:.*/ or
  some Action[*] == '*' or
  some Action[*] == /(?i)^s3:.*/
]
let builder_assume_s3_statements = %builder_assume_role_statements[
  Action == '*' or
  Action == /(?i)^s3:.*/ or
  some Action[*] == '*' or
  some Action[*] == /(?i)^s3:.*/
]
let controller_assume_s3_statements = %controller_assume_role_statements[
  Action == '*' or
  Action == /(?i)^s3:.*/ or
  some Action[*] == '*' or
  some Action[*] == /(?i)^s3:.*/
]

let builder_s3_sids = [
  'LocateCorpusBucket',
  'ListCorpusNamespaces',
  'ReadBuilderInputs',
  'ReadWriteBuildArtifacts'
]
let endpoint_s3_sids = [
  'CorpusBucketLocation',
  'CorpusBucketListing',
  'ReadBuilderInputs',
  'ReadWriteBuildArtifacts'
]
let approved_s3_actions = [
  's3:AbortMultipartUpload',
  's3:GetBucketLocation',
  's3:GetObject',
  's3:GetObjectAttributes',
  's3:GetObjectVersion',
  's3:ListBucket',
  's3:ListBucketVersions',
  's3:ListMultipartUploadParts',
  's3:PutObject'
]
let approved_s3_resources = [
  '${ArtifactBucket.Arn}/v2/builds/*',
  '${ArtifactBucket.Arn}/v2/packages/*',
  '${ArtifactBucket.Arn}/v2/sources/*'
]
let approved_list_prefixes = [
  'v2/builds',
  'v2/builds/*',
  'v2/packages',
  'v2/packages/*',
  'v2/sources',
  'v2/sources/*'
]
let builder_allowed_actions = [
  's3:GetBucketLocation',
  's3:ListBucket',
  's3:ListBucketVersions',
  's3:GetObject',
  's3:GetObjectAttributes',
  's3:GetObjectVersion',
  's3:PutObject',
  's3:AbortMultipartUpload',
  's3:ListMultipartUploadParts',
  'kms:Decrypt',
  'kms:DescribeKey',
  'kms:Encrypt',
  'kms:GenerateDataKey',
  'logs:CreateLogStream',
  'logs:PutLogEvents'
]
let controller_allowed_actions = [
  'ec2:CreateTags',
  'ec2:DescribeImages',
  'ec2:DescribeInstanceAttribute',
  'ec2:DescribeInstances',
  'ec2:DescribeInstanceTypeOfferings',
  'ec2:DescribeLaunchTemplateVersions',
  'ec2:ModifyInstanceAttribute',
  'ec2:RunInstances',
  'ec2:TerminateInstances',
  'iam:PassRole',
  'kms:CreateGrant',
  'kms:Decrypt',
  'kms:DescribeKey',
  'kms:GenerateDataKeyWithoutPlaintext',
  'kms:ReEncryptFrom',
  'kms:ReEncryptTo',
  'ssm:DescribeInstanceInformation',
  'ssm:GetCommandInvocation',
  'ssm:ListCommands',
  'ssm:SendCommand',
  'sts:GetCallerIdentity'
]

rule policy_statement_basics(statements) {
  %statements {
    NotAction !exists
    NotResource !exists
    Action is_string or Action is_list
    when Action is_string {
      Action != '*'
      Action != /.*\*.*/
    }
    when Action is_list {
      Action[*] is_string
      Action[*] != '*'
      Action[*] != /.*\*.*/
    }
  }
}

rule exact_action_allowlist(statements, allowed_actions) {
  %statements {
    when Action is_string {
      Action IN %allowed_actions
    }
    when Action is_list {
      Action[*] IN %allowed_actions
    }
  }
}

rule exact_s3_statement_shape(statements, allowed_sids) {
  %statements {
    Sid IN %allowed_sids
    Action is_string or Action is_list
    Resource is_struct or Resource is_list
    when Action is_string {
      Action IN %approved_s3_actions
    }
    when Action is_list {
      Action[*] IN %approved_s3_actions
    }
    when Resource is_struct {
      Resource[ keys == 'Fn::Sub' ] !empty or
      Resource[ keys == 'Fn::GetAtt' ] !empty
      Resource[ keys != /^(Fn::Sub|Fn::GetAtt)$/ ] empty
      Resource[ keys == 'Fn::Sub' ] IN %approved_s3_resources
      Resource[ keys == 'Fn::GetAtt' ] == ['ArtifactBucket', 'Arn']
    }
    when Resource is_list {
      Resource[*] is_struct
      Resource[*][ keys != /^(Fn::Sub|Fn::GetAtt)$/ ] empty
      Resource[*][ keys == 'Fn::Sub' ] IN %approved_s3_resources
      Resource[*][ keys == 'Fn::GetAtt' ] == ['ArtifactBucket', 'Arn']
    }
  }
}

