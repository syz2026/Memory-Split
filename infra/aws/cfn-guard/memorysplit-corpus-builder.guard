  Resources.BuilderSecurityGroup.Type == 'AWS::EC2::SecurityGroup'
  Resources.EndpointSecurityGroup.Type == 'AWS::EC2::SecurityGroup'
  Resources.BuilderToEndpointHttpsIngress.Type == 'AWS::EC2::SecurityGroupIngress'
  Resources.DataKey.Type == 'AWS::KMS::Key'
  Resources.BuilderLogGroup.Type == 'AWS::Logs::LogGroup'
  Resources.ArtifactBucket.Type == 'AWS::S3::Bucket'
  Resources.ArtifactBucketPolicy.Type == 'AWS::S3::BucketPolicy'
  Resources.BuilderRole.Type == 'AWS::IAM::Role'
  Resources.ControllerRole.Type == 'AWS::IAM::Role'
  Resources.BuilderInstanceProfile.Type == 'AWS::IAM::InstanceProfile'
  Resources.BuilderCommandDocument.Type == 'AWS::SSM::Document'
  Resources.BuilderLaunchTemplate.Type == 'AWS::EC2::LaunchTemplate'
  Resources.S3Endpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.Ec2Endpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.Ec2MessagesEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.KmsEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.LogsEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.SsmEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.SsmMessagesEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.StsEndpoint.Type == 'AWS::EC2::VPCEndpoint'
  Resources.MonthlyBudget.Type == 'AWS::Budgets::Budget'
}

rule no_paid_capacity_resources {
  %ec2_instances empty
  %auto_scaling_groups empty
  %ec2_fleets empty
  %spot_fleets empty
  %capacity_reservations empty
  %capacity_reservation_fleets empty
}

rule no_public_or_unreviewed_network_resources {
  %internet_gateways empty
  %nat_gateways empty
  %elastic_ips empty
  %gateway_attachments empty
  %public_routes empty
  %all_routes empty
  %key_pairs empty
  %ecr_repositories empty
}

rule private_single_az_network {
  let subnet_count = count(%subnets)
  let endpoint_count = count(%vpc_endpoints)
  let builder_egress = Resources.BuilderSecurityGroup.Properties.SecurityGroupEgress[*]
  let interface_endpoint_egress = %builder_egress[
    DestinationSecurityGroupId exists
  ]
  let s3_gateway_egress = %builder_egress[
    DestinationPrefixListId exists
  ]
  let builder_egress_count = count(%builder_egress)
  let interface_endpoint_egress_count = count(%interface_endpoint_egress)
  let s3_gateway_egress_count = count(%s3_gateway_egress)
  let endpoint_egress_count = count(Resources.EndpointSecurityGroup.Properties.SecurityGroupEgress[*])

  %subnet_count == 1
  %endpoint_count == 8
  %builder_egress_count == 2
  %interface_endpoint_egress_count == 1
  %s3_gateway_egress_count == 1
  %endpoint_egress_count == 1
  %subnets.Properties.MapPublicIpOnLaunch == false
  Resources.PrivateSubnet.Properties.AvailabilityZone.Ref == 'BuilderAvailabilityZone'
  Resources.BuilderSecurityGroup.Properties.SecurityGroupIngress empty
  Resources.EndpointSecurityGroup.Properties.SecurityGroupIngress empty
  Resources.EndpointSecurityGroup.Properties.SecurityGroupEgress[*] {
    CidrIp == '127.0.0.1/32'
    Description == 'No-op rule suppresses default allow-all egress'
    IpProtocol == '-1'
    CidrIpv6 !exists
    DestinationPrefixListId !exists
    DestinationSecurityGroupId !exists
  }

  %interface_endpoint_egress {
    Description == 'HTTPS to the interface VPC endpoints'
    DestinationSecurityGroupId[ keys == 'Fn::GetAtt' ] == ['EndpointSecurityGroup', 'GroupId']
    FromPort == 443
    ToPort == 443
    IpProtocol == 'tcp'
    CidrIp !exists
    CidrIpv6 !exists
  }
  %s3_gateway_egress {
    Description == 'HTTPS to the us-east-1 S3 gateway endpoint'
    DestinationPrefixListId.Ref == 'S3GatewayPrefixListId'
    FromPort == 443
    ToPort == 443
    IpProtocol == 'tcp'
    CidrIp !exists
    CidrIpv6 !exists
  }
  Resources.BuilderToEndpointHttpsIngress.Properties {
    Description == 'HTTPS from the corpus builder security group'
    FromPort == 443
    ToPort == 443
    IpProtocol == 'tcp'
    GroupId[ keys == 'Fn::GetAtt' ] == ['EndpointSecurityGroup', 'GroupId']
    SourceSecurityGroupId[ keys == 'Fn::GetAtt' ] == ['BuilderSecurityGroup', 'GroupId']
    CidrIp !exists
    CidrIpv6 !exists
  }
  Parameters.S3GatewayPrefixListId.Type == 'String'
  Parameters.S3GatewayPrefixListId.AllowedPattern == '^pl-[0-9a-f]+$'
}

